table filmes
	lineageTag: fe9004ec-6841-40d6-9a98-9386dacf7d0f

	measure 'Total de filmes' = COUNTROWS(filmes)
		formatString: #,0
		lineageTag: 9a7f68f5-ac92-43c0-a610-4bdd313fab6e

	measure 'Filmes com nota' = CALCULATE(COUNTROWS(filmes), filmes[classificacao_score] <> "Sem nota")
		formatString: #,0
		lineageTag: c97ea7ab-4fa4-46ec-8d0d-1985b41945c8

	measure 'Filmes sem nota' = CALCULATE(COUNTROWS(filmes), filmes[classificacao_score] = "Sem nota")
		formatString: #,0
		lineageTag: 4d65332e-ee90-41ab-ab42-27f0eb9fad24

	measure 'Nota média' = AVERAGE(filmes[score])
		formatString: 0.0
		lineageTag: 140ddb3b-a126-4e1f-994f-bd79cb195896

	measure 'Filmes bem avaliados' = CALCULATE(COUNTROWS(filmes), filmes[classificacao_score] = "Bem avaliado")
		formatString: #,0
		lineageTag: 9023968e-df9c-4e5b-8636-411a928bdae9

	measure 'Taxa bem avaliados' = DIVIDE([Filmes bem avaliados], [Filmes com nota])
		formatString: 0.0%
		lineageTag: 9d3ccaaa-64fb-471c-9383-834fb75c3e51

	measure 'Taxa bem avaliados por idioma' = IF([Total de filmes] >= 100, [Taxa bem avaliados])
		formatString: 0.0%
		lineageTag: 415f7a0f-c346-4659-ab17-de13a8a18b1a

	measure 'Taxa bem avaliados por pais' = IF(SELECTEDVALUE(filmes[pais_analise]) <> "Indefinido" && [Total de filmes] >= 30, [Taxa bem avaliados])
		formatString: 0.0%
		lineageTag: c28b8740-c002-4188-81ee-8bf62b210599

	measure 'Receita total' = SUM(filmes[receita_analise])
		formatString: #,0,,
		lineageTag: 2ec7a9c1-e6b0-46dd-8e66-73214195e7e8

	measure 'Orçamento total' = SUM(filmes[orcamento_analise])
		formatString: #,0,,
		lineageTag: dfc2aa64-9205-44d0-a975-d653c3f6418f

	measure 'Filmes com financeiro confiável' = CALCULATE(COUNTROWS(filmes), filmes[financeiro_confiavel] = "Sim")
		formatString: #,0
		lineageTag: 1bb8322d-82f0-47c6-a1b5-88715233f052

	measure 'ROI mediano' = MEDIAN(filmes[roi])
		formatString: 0.0
		lineageTag: a5a4f38f-4f60-432d-a015-13987d0e52db

	measure 'Orçamentos suspeitos' = CALCULATE(COUNTROWS(filmes), filmes[orcamento_suspeito] = "Sim")
		formatString: #,0
		lineageTag: 2e836bfa-749d-46d3-b504-e601f52c2972

	measure 'Nota média orçamento alto' = CALCULATE([Nota média], filmes[faixa_orcamento] IN {"100 a 200 milhões", "Acima de 200 milhões"})
		formatString: 0.0
		lineageTag: ee558284-e115-4700-a929-0515be9fa96a

	measure 'Nota média orçamento baixo' = CALCULATE([Nota média], filmes[faixa_orcamento] = "Até 10 milhões")
		formatString: 0.0
		lineageTag: 664d7445-25f0-4338-99a1-5f905ba908ff

	measure 'Insight avaliação' = FORMAT([Taxa bem avaliados], "0.0%") & " dos filmes com nota chegam a 80 ou mais. A nota média do público é " & FORMAT([Nota média], "0.0") & " de 100."
		lineageTag: 6b6ac6d3-0acb-4a7c-964b-bbd09448dd9a

	measure 'Insight bem avaliados' = FORMAT([Filmes bem avaliados], "#,0") & " de " & FORMAT([Filmes com nota], "#,0") & " filmes com nota chegam a 80 ou mais. Idiomas com menos de 100 filmes e países com menos de 30 ficam fora dos percentuais para evitar distorção."
		lineageTag: 2f7b4408-f784-4e0a-814c-2af9f44d35ba

	measure 'Insight comercial' = "Entre os " & FORMAT([Filmes com financeiro confiável], "#,0") & " filmes com orçamento e receita confiáveis, o ROI mediano é " & FORMAT([ROI mediano], "0.0") & "x: a bilheteria típica é " & FORMAT([ROI mediano], "0.0") & " vezes o orçamento."
		lineageTag: 08a9ddce-70f0-496d-9c46-a643675ea168

	measure 'Insight orçamento' = "Filmes de orçamento alto (US$ 100 mi ou mais) têm nota média " & FORMAT([Nota média orçamento alto], "0.0") & ", contra " & FORMAT([Nota média orçamento baixo], "0.0") & " dos filmes de até US$ 10 mi."
		lineageTag: 56f3dbed-157b-4e35-810e-9787d77b0df2

