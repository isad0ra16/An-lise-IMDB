	partition filmes = m
		mode: import
		source =
				let
					Fonte = fonte_csv,
					Colunas = Table.SelectColumns(Fonte, {"id", "titulo", "data_lancamento", "ano", "decada", "score", "faixa_score", "classificacao_score", "genero", "genero_principal", "status", "idioma_original", "pais", "pais_analise", "orcamento", "orcamento_suspeito", "orcamento_analise", "faixa_orcamento", "receita", "receita_suspeita", "receita_analise", "financeiro_conflitante", "financeiro_confiavel", "lucro", "roi"}),
					Tipos = Table.TransformColumnTypes(Colunas, {{"id", Int64.Type}, {"titulo", type text}, {"data_lancamento", type date}, {"ano", Int64.Type}, {"decada", Int64.Type}, {"score", type number}, {"faixa_score", type text}, {"classificacao_score", type text}, {"genero", type text}, {"genero_principal", type text}, {"status", type text}, {"idioma_original", type text}, {"pais", type text}, {"pais_analise", type text}, {"orcamento", type number}, {"orcamento_suspeito", type text}, {"orcamento_analise", type number}, {"faixa_orcamento", type text}, {"receita", type number}, {"receita_suspeita", type text}, {"receita_analise", type number}, {"financeiro_conflitante", type text}, {"financeiro_confiavel", type text}, {"lucro", type number}, {"roi", type number}}, "en-US"),
					OrdemNota = Table.AddColumn(Tipos, "ordem_faixa_score", each let p = List.PositionOf({"Abaixo de 50", "50 a 59", "60 a 69", "70 a 79", "80 ou mais"}, [faixa_score]) in if p = -1 then 6 else p + 1, Int64.Type),
					OrdemOrc = Table.AddColumn(OrdemNota, "ordem_faixa_orcamento", each let p = List.PositionOf({"Até 10 milhões", "10 a 50 milhões", "50 a 100 milhões", "100 a 200 milhões", "Acima de 200 milhões"}, [faixa_orcamento]) in if p = -1 then 6 else p + 1, Int64.Type)
				in
					OrdemOrc

